#!/bin/bash
# scripts/backup_db

set -e

echo "MongoDB Backup Script"
echo "=================================="

# Check required environment variables
required_vars=(MONGO_ROOT_USERNAME MONGO_ROOT_PASSWORD MONGO_DATABASE)
for var in "${required_vars[@]}"; do
    if [[ -z "${!var}" ]]; then
        echo "Error: Environment variable $var is not set"
        exit 1
    fi
done

MONGO_HOST=${MONGO_HOST:-mongo}
MONGO_PORT=${MONGO_PORT:-27017}

# Display connection info (without password)
echo "Connection Info:"
echo "Host: ${MONGO_HOST}"
echo "Port: ${MONGO_PORT}"
echo "User: ${MONGO_ROOT_USERNAME}"
echo "Database: ${MONGO_DATABASE}"
echo ""

# Test database connection
echo "Testing database connection..."
mongosh "mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DATABASE}?authSource=admin" \
    --quiet --eval 'db.runCommand("ping").ok'

echo "Database connection successful"
echo ""

# Create timestamp
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
echo "Creating backup with timestamp: ${TIMESTAMP}"

# mongodump
BACKUP_DIR="dump_${MONGO_DATABASE}_${TIMESTAMP}"
mongodump \
    --host=${MONGO_HOST} \
    --port=${MONGO_PORT} \
    --username=${MONGO_ROOT_USERNAME} \
    --password=${MONGO_ROOT_PASSWORD} \
    --authenticationDatabase=admin \
    --db=${MONGO_DATABASE} \
    --out="${BACKUP_DIR}"
echo "Dump created: ${BACKUP_DIR}"

# Show results
echo ""
echo "Backup files created:"
ls -lhd dump_* 2>/dev/null | head -5

echo ""
echo "Backup completed successfully!"
echo ""
echo "To restore: make mongo-restore RESTORE_DIR=${BACKUP_DIR}"
